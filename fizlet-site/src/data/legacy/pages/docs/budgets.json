 "index": "06",
 "eyebrow": "DOCS · BUDGETS",
 "title": {
  "line": "Every kilobyte",
  "accent": "is a choice."
 },
 "lead": "Each module has a size budget, and CI fails when one is over. The kernel is 3,372 B gzip against a budget of 4,096 B. The table below is not typed: this page is built by the same code that checks the budgets, so the numbers are the ones measured on v0.27.0.",
 "body": [
  {
   "kind": "html",
   "html": "<section class=\"note-block doc-wide\"><h2>Measured on this build</h2><div class=\"panel lit ledger doc-table\"><div class=\"table-scroll\"><table><thead><tr><th>Entry</th><th>Gzip</th><th>Budget</th><th>Used</th></tr></thead><tbody><tr><td><span class=\"el el-chip\" style=\"--tone: var(--k-go)\" aria-hidden=\"true\"><b class=\"el-sym\">kr</b></span><a href=\"/bricks/kernel.html\"><code>@fzlt/core (kernel)</code></a></td><td data-size=\"@fzlt/core (kernel)\">3,372 B</td><td>4,096 B</td><td>82%</td></tr><tr><td><span class=\"el el-chip\" style=\"--tone: var(--k-aim)\" aria-hidden=\"true\"><b class=\"el-sym\">db</b></span><a href=\"/bricks/debug.html\"><code>@fzlt/core/debug</code></a></td><td data-size=\"@fzlt/core/debug\">1,133 B</td><td>1,536 B</td><td>74%</td></tr><tr><td><span class=\"el el-chip\" style=\"--tone: var(--k-sys)\" aria-hidden=\"true\"><b class=\"el-sym\">pf</b></span><a href=\"/bricks/perf.html\"><code>@fzlt/core/perf</code></a></td><td data-size=\"@fzlt/core/perf\">2,019 B</td><td>2,022 B</td><td>100%</td></tr><tr><td><span class=\"el el-chip\" style=\"--tone: var(--k-sys)\" aria-hidden=\"true\"><b class=\"el-sym\">in</b></span><a href=\"/bricks/input.html\"><code>@fzlt/core/input</code></a></td><td data-size=\"@fzlt/core/input\">1,909 B</td><td>1,920 B</td><td>99%</td></tr><tr><td><span class=\"el el-chip\" style=\"--tone: var(--k-advance)\" aria-hidden=\"true\"><b class=\"el-sym\">pd</b></span><a href=\"/bricks/pad.html\"><code>@fzlt/core/pad</code></a></td><td data-size=\"@fzlt/core/pad\">2,068 B</td><td>2,120 B</td><td>98%</td></tr><tr><td><span class=\"el el-chip\" style=\"--tone: var(--k-cmd)\" aria-hidden=\"true\"><b class=\"el-sym\">cl</b></span><a href=\"/bricks/collide.html\"><code>@fzlt/core/collide</code></a></td><td data-size=\"@fzlt/core/collide\">1,265 B</td><td>1,536 B</td><td>82%</td></tr><tr><td><span class=\"el el-chip\" style=\"--tone: var(--k-flag)\" aria-hidden=\"true\"><b class=\"el-sym\">gr</b></span><a href=\"/bricks/grid.html\"><code>@fzlt/core/grid</code></a></td><td data-size=\"@fzlt/core/grid\">1,652 B</td><td>1,664 B</td><td>99%</td></tr><tr><td><span class=\"el el-chip\" style=\"--tone: var(--k-attack)\" aria-hidden=\"true\"><b class=\"el-sym\">fx</b></span><a href=\"/bricks/fx.html\"><code>@fzlt/core/fx</code></a></td><td data-size=\"@fzlt/core/fx\">2,792 B</td><td>3,072 B</td><td>91%</td></tr><tr><td><span class=\"el el-chip\" style=\"--tone: var(--k-go)\" aria-hidden=\"true\"><b class=\"el-sym\">cm</b></span><a href=\"/bricks/camera.html\"><code>@fzlt/core/camera</code></a></td><td data-size=\"@fzlt/core/camera\">1,400 B</td><td>1,536 B</td><td>91%</td></tr><tr><td><span class=\"el el-chip\" style=\"--tone: var(--k-fallin)\" aria-hidden=\"true\"><b class=\"el-sym\">sp</b></span><a href=\"/bricks/sprite.html\"><code>@fzlt/core/sprite</code></a></td><td data-size=\"@fzlt/core/sprite\">1,437 B</td><td>1,536 B</td><td>94%</td></tr><tr><td><span class=\"el el-chip\" style=\"--tone: var(--k-advance)\" aria-hidden=\"true\"><b class=\"el-sym\">sn</b></span><a href=\"/bricks/sound.html\"><code>@fzlt/core/sound</code></a></td><td data-size=\"@fzlt/core/sound\">1,062 B</td><td>1,536 B</td><td>69%</td></tr><tr><td><span class=\"el el-chip\" style=\"--tone: var(--k-fallin)\" aria-hidden=\"true\"><b class=\"el-sym\">em</b></span><a href=\"/bricks/embed.html\"><code>@fzlt/core/embed</code></a></td><td data-size=\"@fzlt/core/embed\">2,040 B</td><td>2,560 B</td><td>80%</td></tr><tr><td><span class=\"el el-chip\" style=\"--tone: var(--k-sys)\" aria-hidden=\"true\"><b class=\"el-sym\">sl</b></span><a href=\"/bricks/slot.html\"><code>@fzlt/core/slot</code></a></td><td data-size=\"@fzlt/core/slot\">1,849 B</td><td>2,048 B</td><td>90%</td></tr><tr><td><span class=\"el el-chip\" style=\"--tone: var(--k-cmd)\" aria-hidden=\"true\"><b class=\"el-sym\">pr</b></span><a href=\"/bricks/presence.html\"><code>@fzlt/core/presence</code></a></td><td data-size=\"@fzlt/core/presence\">2,197 B</td><