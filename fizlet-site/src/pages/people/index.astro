---
// People: the maker first, then the creators, the AI agents and the studio crew, one card each.
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHead from "../../components/SectionHead.astro";
import PersonCard from "../../components/PersonCard.astro";
import DATA from "../../data/legacy/pages/people/index.json";
const p = DATA as any;
---
<BaseLayout meta={p.meta}>
<section class={p.cls} aria-labelledby="ppl-index">
  <div class="wrap">
    <SectionHead index={p.head.index} eyebrow={p.head.eyebrow} line={p.head.title.line} accent={p.head.title.accent} lead={p.head.lead} id="ppl-index" />
    <ul class="ppl-tiles">
    {p.people.map((x: any) => <PersonCard {...x} />)}
    </ul>
  </div>
</section>
</BaseLayout>
