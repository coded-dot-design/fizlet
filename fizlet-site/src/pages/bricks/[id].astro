---
// A brick page (bricks/<id>.html): crumbs, the brick's head and measured sizes, its live demo and
// toy card, its status, its use snippets as code cards, its whole API, and previous / next.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Crumbs from "../../components/Crumbs.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import BrickHead from "../../components/BrickHead.astro";
import BrickSizes from "../../components/BrickSizes.astro";
import BrickDemo from "../../components/BrickDemo.astro";
import ToyCard from "../../components/ToyCard.astro";
import BrickApi from "../../components/BrickApi.astro";
import DocSteps from "../../components/DocSteps.astro";
import Html from "../../components/Html.astro";

export function getStaticPaths() {
  const all = import.meta.glob<{ default: any }>("../../data/legacy/pages/bricks/*.json", { eager: true });
  return Object.entries(all).map(([f, m]) => ({ params: { id: f.match(/([\w-]+)\.json$/)![1] }, props: { brick: m.default } }));
}
const { brick } = Astro.props;
---
<BaseLayout meta={brick.meta} styles={brick.styles}>
<section class="has-grid section bp" aria-labelledby="bp-title">
  <div class="wrap">
    <Crumbs trail={brick.crumbs.trail} current={brick.crumbs.current} />
    <div class="split bp-top" style={`--tone: ${brick.tone}`}>
      <BrickHead {...brick.head} />
      <BrickSizes sizes={brick.sizes} note={brick.sizesNote} />
    </div>
    {brick.blocks.map((b: any) => b.kind === "demo" ? <BrickDemo {...b} />
      : b.kind === "toy" ? <div class="bp-card">{b.slot && <ToyCard {...b} />}</div>
      : b.kind === "use" ? <div class="bp-use">{b.blocks.map((c: any) => <CodeBlock label={c.label} code={c.code} wrap={c.wrap} copy={c.copy} class={c.cls} />)}</div>
      : b.kind === "code" ? <CodeBlock label={b.label} code={b.code} wrap={b.wrap} copy={b.copy} class={b.cls} />
      : b.kind === "api" ? <BrickApi {...b} />
      : b.kind === "steps" ? <DocSteps steps={b.steps} label="More bricks" code />
      : <Html html={b.html} />)}
  </div>
</section>
</BaseLayout>
