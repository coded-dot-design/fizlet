---
// A Daily piece: its stage (the piece's poster until it nears the screen, then the piece live),
// then its line (number · date · theme · how it was made), its title and the rest of its meta.
// Its title is the next level under the page's head: h2 on a flat page, h3 under an archive theme head.
interface Props { id: string; cls: string; attrs: Record<string, string>; stage: string; index: string; line: string; title: string; level?: string; metaHtml: string }
const { id, cls, attrs, stage, index, line, title, level = "h2", metaHtml } = Astro.props;
const H = level === "h3" ? "h3" : "h2";
---
<li class={cls} id={id} {...attrs}>
      <div class="gal-stage" set:html={stage} />
      <div class="gal-meta">
        <p class="eyebrow gal-line"><span class="index">{index}</span> {line}</p>
        <H class="gal-title">{title}</H>
        <Fragment set:html={metaHtml} />
      </div>
    </li>
