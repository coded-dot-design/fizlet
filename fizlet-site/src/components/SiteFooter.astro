---
import Lockup from "./Lockup.astro";
import SiteMap from "./SiteMap.astro";
import { AUTHOR, HUB } from "../lib/site";
interface Props { path: string }
const { path } = Astro.props;
---
<footer class="site-foot">
  <div class="wrap">
    <div class="foot-brand">
      <a class="brand" href="/">
        <Lockup fzlt />
      </a>
      <p>Fizlet™ is the building blocks for animation and games on the DOM, by <a href={AUTHOR}>Chris Cooley ↗</a>. Bring the logic and style; the bricks do the rest, and the page always comes back.</p>
      <p class="foot-note"><a href={HUB}>DOM VIRUS ↗</a> is one use of the bricks: its games run on Fizlet.</p>
      <p class="foot-note">Fizlet and fzlt are trademarks of Chris Cooley.</p>
    </div>
    <SiteMap path={path} />
  </div>
  <div class="foot-base">
    <div class="wrap"><span>© 2026 Chris Cooley · MIT licence · no runtime dependencies<span class="foot-cc"> · <button type="button" class="text-btn" data-cookie-settings hidden>Cookie settings</button></span></span><span>By <a href={AUTHOR}>Chris Cooley ↗</a> · coded.design</span></div>
  </div>
</footer>
