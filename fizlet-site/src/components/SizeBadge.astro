---
// The size badge: gzip bytes on a token-styled sticker ("3.3 KB gz"), measured by the build.
// `live`: what was measured (a built file, or "size:<entry>"); `what`: what it is (screen readers).
interface Props { bytes: number; live: string; what?: string }
const { bytes, live, what = "live code" } = Astro.props;
const n = bytes.toLocaleString("en-US"), kb = (bytes / 1024).toFixed(1);
---
<span class="size-badge" role="img" aria-label={`${kb} KB gzipped: ${what}, ${n} bytes, measured at build`} data-size-badge data-bytes={bytes} data-live={live} title={`${n} B gzip, measured at build`}><b>{kb} KB</b> gz</span>
