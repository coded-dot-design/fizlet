---
// A callout: a panel that sets a note apart from the prose (the contest rules, a warning), a <div>
// or, with its heading's id in `labelledby`, a <section>.
interface Props { class?: string; tone?: string; tag?: "div" | "section"; labelledby?: string }
const { class: cls = "", tone, tag = "div", labelledby } = Astro.props;
const Tag = tag;
---
<Tag class={["panel", cls].filter(Boolean).join(" ")} style={tone ? `--tone: ${tone}` : undefined} aria-labelledby={labelledby}><slot /></Tag>
