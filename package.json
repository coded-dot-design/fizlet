{
  "name": "fizlet",
  "version": "0.19.0",
  "description": "Tiny physics for your page: a micro game and animation engine for the DOM, by Chris Cooley. One loop, bounded everything, and the page always comes back.",
  "license": "MIT",
  "author": "Chris Cooley <https://coded.design>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coded-dot-design/fizlet.git"
  },
  "homepage": "https://coded-dot-design.github.io/fizlet/",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "default": "./dist/kernel/index.js"
    },
    "./debug": {
      "types": "./dist/debug.d.ts",
      "default": "./dist/debug.js"
    },
    "./perf": {
      "types": "./dist/perf.d.ts",
      "default": "./dist/perf.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "default": "./dist/input.js"
    },
    "./pad": {
      "types": "./dist/pad.d.ts",
      "default": "./dist/pad.js"
    },
    "./collide": {
      "types": "./dist/collide.d.ts",
      "default": "./dist/collide.js"
    },
    "./grid": {
      "types": "./dist/grid.d.ts",
      "default": "./dist/grid.js"
    },
    "./fx": {
      "types": "./dist/fx.d.ts",
      "default": "./dist/fx.js"
    },
    "./camera": {
      "types": "./dist/camera.d.ts",
      "default": "./dist/camera.js"
    },
    "./sprite": {
      "types": "./dist/sprite.d.ts",
      "default": "./dist/sprite.js"
    },
    "./sound": {
      "types": "./dist/sound.d.ts",
      "default": "./dist/sound.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "default": "./dist/embed.js"
    },
    "./touch": {
      "types": "./dist/touch.d.ts",
      "default": "./dist/touch.js"
    },
    "./slot": {
      "types": "./dist/slot.d.ts",
      "default": "./dist/slot.js"
    },
    "./presence": {
      "types": "./dist/presence.d.ts",
      "default": "./dist/presence.js"
    },
    "./presence/check": {
      "types": "./dist/presence-check.d.ts",
      "default": "./dist/presence-check.js"
    },
    "./hud": {
      "types": "./dist/hud.d.ts",
      "default": "./dist/hud.js"
    },
    "./match": {
      "types": "./dist/match.d.ts",
      "default": "./dist/match.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "default": "./dist/rules.js"
    },
    "./steer": {
      "types": "./dist/steer.d.ts",
      "default": "./dist/steer.js"
    },
    "./coach": {
      "types": "./dist/coach.d.ts",
      "default": "./dist/coach.js"
    },
    "./timeline": {
      "types": "./dist/timeline.d.ts",
      "default": "./dist/timeline.js"
    },
    "./arcade": {
      "types": "./dist/arcade.d.ts",
      "default": "./dist/arcade.js"
    },
    "./board-page": {
      "types": "./dist/board-page.d.ts",
      "default": "./dist/board-page.js"
    },
    "./ui": {
      "types": "./dist/ui/board-ui.d.ts",
      "default": "./dist/ui/board-ui.js"
    },
    "./ui/board-ui.css": "./dist/ui/board-ui.css",
    "./ui/tokens.json": "./dist/ui/tokens.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p . --exactOptionalPropertyTypes && tsc -p site/tsconfig.json && tsc -p site/demos/fizz/tsconfig.json",
    "test": "node --expose-gc --import tsx --test --test-concurrency=1 tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "size": "node scripts/size.mjs",
    "test:browser": "node tests/browser.mjs && node tests/fizz.mjs && node tests/camera.mjs && node tests/arcade.mjs && node tests/arcade-hud.mjs && node tests/coach.mjs && node tests/timeline.mjs && node tests/labs.mjs && node tests/touch.mjs",
    "test:layers": "tsc -p site/demos/layers/tsconfig.json && node tests/layers.mjs",
    "test:pack": "node scripts/pack-smoke.mjs",
    "site": "npm run build && node scripts/site.mjs",
    "test:site": "node tests/site.mjs",
    "prepack": "npm run build",
    "perf": "npm run site && node tests/perf/run.mjs",
    "test:alloc": "node tests/perf/alloc.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.58.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "keywords": [
    "dom",
    "animation",
    "game-engine",
    "physics",
    "micro",
    "canvas",
    "astro",
    "zero-dependencies"
  ],
  "bugs": {
    "url": "https://github.com/coded-dot-design/fizlet/issues"
  }
}
